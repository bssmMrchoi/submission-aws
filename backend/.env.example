# ============================================================
# submission-aws 백엔드 환경설정
# 이 파일을 .env 로 복사한 뒤 값을 채운다:  cp .env.example .env
# .env 는 GitHub에 올리지 않는다 (.gitignore 에 포함됨)
# 값이 비어 있으면 아래 "비었을 때" 동작으로 실행된다.
# 값을 바꾼 뒤에는 서버를 다시 시작해야 반영된다.
# ============================================================

# ---------- RDS (MySQL) ----------
# 비었을 때: DB_HOST가 비어 있으면 로컬 SQLite 파일(backend/local.db)을 사용한다.
# DB_HOST: RDS 엔드포인트 (예: submission-db.xxxxxxxx.ap-northeast-2.rds.amazonaws.com)
# DB_NAME: RDS 생성 시 "초기 데이터베이스 이름" / DB_USER, DB_PASSWORD: RDS 마스터 사용자·암호
DB_HOST=
DB_PORT=3306
DB_NAME=submission
DB_USER=admin
DB_PASSWORD=

# ---------- S3 (과제 파일 저장) ----------
# 비었을 때: S3_BUCKET이 비어 있으면 업로드/다운로드가 막히고 화면에 안내가 뜬다.
# S3_BUCKET 예: submission-files-hong
AWS_REGION=ap-northeast-2
S3_BUCKET=

# 액세스 키: 로컬 PC에서 IAM 사용자 키로 테스트할 때만 입력한다.
# EC2에서는 비워 두고 IAM 역할을 연결한다 (권장).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
